<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>NEBULOSO | Xbox Cyber Arcade & Dev Mode Store</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Press+Start+2P&family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        xbox: {
                            DEFAULT: '#00FC60',
                            glow: '#00FF66',
                            dark: '#107C41',
                            deep: '#054B26'
                        },
                        cyber: {
                            black: '#07070c',
                            card: 'rgba(10, 14, 23, 0.85)',
                            border: '#1f293d',
                            cyan: '#00F0FF',
                            purple: '#8A2BE2',
                            pink: '#FF007F'
                        }
                    },
                    fontFamily: {
                        orbitron: ['Orbitron', 'sans-serif'],
                        pixel: ['"Press Start 2P"', 'monospace'],
                        rajdhani: ['Rajdhani', 'sans-serif'],
                        sans: ['Inter', 'sans-serif']
                    },
                    boxShadow: {
                        'neon-xbox': '0 0 18px rgba(0, 252, 96, 0.5), 0 0 35px rgba(0, 252, 96, 0.25)',
                        'neon-cyan': '0 0 18px rgba(0, 240, 255, 0.5), 0 0 35px rgba(0, 240, 255, 0.25)',
                        'neon-purple': '0 0 18px rgba(138, 43, 226, 0.5)'
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #07070c;
        }
        ::-webkit-scrollbar-thumb {
            background: #107C41;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00FC60;
        }

        /* Neon Flicker Effect */
        @keyframes neon-flicker {
            0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% {
                text-shadow: 0 0 5px #00FC60, 0 0 12px #00FC60, 0 0 25px #00FC60, 0 0 45px #107C41;
            }
            20%, 24%, 55% {
                text-shadow: none;
            }
        }

        .neon-text-xbox {
            color: #00FC60;
            animation: neon-flicker 4s infinite alternate;
        }

        /* Background Overlay */
        .site-bg-overlay {
            position: fixed;
            inset: 0;
            z-index: 0;
            background-image: url('https://i.postimg.cc/h47j60wZ/NEBULOSO.png');
            background-repeat: no-repeat;
            background-position: center top;
            background-size: cover;
            background-attachment: fixed;
            filter: brightness(0.85) contrast(1.15) opacity(0.95);
            transition: all 0.3s ease-in-out;
            pointer-events: none !important;
        }

        @media (max-width: 768px) {
            .site-bg-overlay {
                background-position: center top;
                background-size: cover;
                background-attachment: scroll;
                filter: brightness(0.80) contrast(1.15) opacity(0.92);
            }
        }

        /* Particle Canvas */
        #snow-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none !important;
            z-index: 2;
        }

        /* Scanline Overlay */
        .scanline {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                to bottom,
                rgba(255,255,255,0),
                rgba(255,255,255,0) 50%,
                rgba(0, 0, 0, 0.25) 50%,
                rgba(0, 0, 0, 0.25)
            );
            background-size: 100% 4px;
            pointer-events: none !important;
            z-index: 3;
            opacity: 0.25;
        }

        /* Clip Corner Styles */
        .clip-corner {
            clip-path: polygon(0 0, calc(100% - 15px) 0, 100% 15px, 100% 100%, 15px 100%, 0 calc(100% - 15px));
        }

        .clip-btn {
            clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
        }

        /* Mobile Touch Optimizations */
        button, a, input {
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }
    </style>
</head>
<body class="bg-cyber-black text-gray-200 font-sans antialiased min-h-screen relative overflow-x-hidden selection:bg-xbox selection:text-black">

    <!-- Background Effects -->
    <div class="site-bg-overlay"></div>
    <div class="fixed inset-0 bg-gradient-to-b from-cyber-black/60 via-cyber-black/45 to-cyber-black/70 z-[1] pointer-events-none"></div>
    <canvas id="snow-canvas"></canvas>
    <div class="scanline"></div>

    <div class="relative z-10 flex flex-col min-h-screen">

        <!-- HEADER / NAVIGATION -->
        <header class="sticky top-0 z-40 bg-cyber-black/85 backdrop-blur-md border-b border-cyber-border/80 shadow-xl">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
                
                <a href="#" class="flex items-center space-x-3 group">
                    <div class="w-11 h-11 rounded-full bg-black border-2 border-xbox flex items-center justify-center shadow-neon-xbox group-hover:scale-105 transition-transform">
                        <i class="fa-brands fa-xbox text-xbox text-2xl group-hover:rotate-12 transition-transform"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-orbitron text-2xl font-black tracking-widest neon-text-xbox uppercase">
                            NEBULOSO
                        </span>
                        <span class="font-pixel text-[8px] text-cyber-cyan tracking-tighter">XBOX DEV ARCADE</span>
                    </div>
                </a>

                <nav class="hidden lg:flex items-center space-x-8 font-rajdhani text-lg font-semibold tracking-wide">
                    <a href="#hero" class="hover:text-xbox transition-colors py-1 border-b-2 border-transparent hover:border-xbox">Início</a>
                    <a href="#packages" class="hover:text-xbox transition-colors py-1 border-b-2 border-transparent hover:border-xbox">Pacotes Dev Mode</a>
                    <a href="#emulators" class="hover:text-xbox transition-colors py-1 border-b-2 border-transparent hover:border-xbox">Emuladores</a>
                    <a href="#devmode" class="hover:text-xbox transition-colors py-1 border-b-2 border-transparent hover:border-xbox">Como Instalar</a>
                    <a href="#guides" class="hover:text-xbox transition-colors py-1 border-b-2 border-transparent hover:border-xbox">Suporte FAQ</a>
                </nav>

                <div class="flex items-center space-x-4">
                    <div class="relative hidden sm:block w-48 md:w-60">
                        <input type="text" id="searchInput" placeholder="Buscar no sistema..." 
                            class="w-full bg-black/70 border border-cyber-border rounded-lg py-2 pl-9 pr-4 text-xs font-rajdhani text-gray-200 placeholder-gray-500 focus:outline-none focus:border-xbox focus:ring-1 focus:ring-xbox transition-all">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-xs text-gray-400"></i>
                    </div>

                    <button id="cartBtn" type="button" class="relative p-2.5 bg-black/90 border border-xbox/50 rounded-lg text-xbox hover:bg-xbox hover:text-black hover:shadow-neon-xbox transition-all cursor-pointer">
                        <i class="fa-solid fa-cart-shopping text-lg pointer-events-none"></i>
                        <span id="cartCount" class="absolute -top-2 -right-2 bg-cyber-pink text-white font-bold font-orbitron text-[10px] w-5 h-5 rounded-full flex items-center justify-center border border-black shadow-md pointer-events-none">1</span>
                    </button>

                    <button id="mobileMenuBtn" type="button" class="lg:hidden p-2 text-gray-300 hover:text-xbox focus:outline-none cursor-pointer">
                        <i class="fa-solid fa-bars text-2xl pointer-events-none"></i>
                    </button>
                </div>
            </div>

            <div id="mobileMenu" class="hidden lg:hidden bg-black/95 border-b border-cyber-border px-4 pt-2 pb-6 space-y-3 font-rajdhani text-lg">
                <div class="pt-2 pb-3">
                    <input type="text" id="mobileSearchInput" placeholder="Buscar pacotes..." 
                        class="w-full bg-cyber-black border border-cyber-border rounded-lg py-2 px-4 text-sm text-gray-200 focus:border-xbox focus:outline-none">
                </div>
                <a href="#hero" class="block text-gray-300 hover:text-xbox py-1 border-l-2 border-transparent hover:border-xbox pl-2">Início</a>
                <a href="#packages" class="block text-gray-300 hover:text-xbox py-1 border-l-2 border-transparent hover:border-xbox pl-2">Pacotes Dev Mode</a>
                <a href="#emulators" class="block text-gray-300 hover:text-xbox py-1 border-l-2 border-transparent hover:border-xbox pl-2">Emuladores Suportados</a>
                <a href="#devmode" class="block text-gray-300 hover:text-xbox py-1 border-l-2 border-transparent hover:border-xbox pl-2">Guia de Instalação</a>
            </div>
        </header>

        <!-- HERO BANNER SECTION -->
        <section id="hero" class="relative py-16 lg:py-24 overflow-hidden border-b border-cyber-border/70">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    
                    <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                        <div class="inline-flex items-center space-x-2 bg-black/80 border border-xbox/60 rounded-full px-4 py-1.5 shadow-neon-xbox">
                            <span class="w-2.5 h-2.5 rounded-full bg-xbox animate-pulse"></span>
                            <span class="font-rajdhani font-bold text-xs sm:text-sm text-xbox tracking-wider uppercase">SUPORTE TOTAL XBOX SERIES X|S & ONE</span>
                        </div>

                        <h1 class="font-orbitron font-black text-3xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-none uppercase drop-shadow-lg">
                            SISTEMA COMPLETO <br>
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-xbox via-cyber-cyan to-cyber-purple">
                                DEV MODE XBOX & ARCADE
                            </span>
                        </h1>

                        <p class="font-sans text-gray-200 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed drop-shadow-md">
                            Transforme seu Xbox em uma máquina retro definitiva! Escolha entre o pacote <strong>BÁSICO (R$ 30,00)</strong> para emulação essencial ou o <strong>CRISTALINO (R$ 49,90)</strong> para alta performance em 4K.
                        </p>

                        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
                            <a href="#packages" class="w-full sm:w-auto px-8 py-4 bg-xbox text-black font-orbitron font-bold text-sm tracking-wider uppercase rounded hover:bg-xbox-glow hover:shadow-neon-xbox transition-all text-center clip-btn cursor-pointer">
                                <i class="fa-solid fa-gamepad mr-2"></i> Ver Todos os Pacotes
                            </a>
                            <a href="#devmode" class="w-full sm:w-auto px-8 py-4 bg-black/90 border border-cyber-cyan text-cyber-cyan hover:text-black font-orbitron font-bold text-sm tracking-wider uppercase rounded hover:bg-cyber-cyan hover:shadow-neon-cyan transition-all text-center clip-btn cursor-pointer">
                                <i class="fa-solid fa-code mr-2"></i> Tutorial Dev Mode
                            </a>
                        </div>

                        <div class="grid grid-cols-3 gap-4 pt-8 border-t border-gray-800/80 max-w-lg mx-auto lg:mx-0">
                            <div>
                                <span class="font-orbitron text-2xl font-bold text-xbox block">100%</span>
                                <span class="font-rajdhani text-xs text-gray-300">Seguro & Oficial</span>
                            </div>
                            <div>
                                <span class="font-orbitron text-2xl font-bold text-cyber-cyan block">+50.000</span>
                                <span class="font-rajdhani text-xs text-gray-300">Jogos Suportados</span>
                            </div>
                            <div>
                                <span class="font-orbitron text-2xl font-bold text-cyber-purple block">4K 60FPS</span>
                                <span class="font-rajdhani text-xs text-gray-300">Ultra Desempenho</span>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-5 flex justify-center">
                        <div class="relative w-full max-w-md bg-cyber-card border-2 border-xbox rounded-xl p-6 shadow-neon-xbox backdrop-blur-md clip-corner">
                            <div class="absolute -top-3 right-6 bg-cyber-pink text-white font-orbitron text-[10px] font-bold px-3 py-1 rounded shadow-lg uppercase tracking-wider">
                                ⚡ O MAIS VENDIDO
                            </div>

                            <div class="relative h-56 rounded-lg overflow-hidden mb-5 border border-cyber-border">
                                <img src="https://i.postimg.cc/h47j60wZ/NEBULOSO.png" 
                                     alt="DEV MODE CRISTALINO NEBULOSO" class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-500">
                                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                                <div class="absolute bottom-3 left-3 bg-black/90 px-3 py-1 rounded border border-xbox text-xbox font-orbitron text-xs font-bold">
                                    <i class="fa-solid fa-gem mr-1"></i> DEV MODE CRISTALINO
                                </div>
                            </div>

                            <h3 class="font-orbitron text-2xl font-black text-white mb-1">
                                DEV MODE CRISTALINO
                            </h3>
                            <p class="font-sans text-xs text-gray-300 mb-4 leading-relaxed">
                                Pacote supremo otimizado. Inclui BIOS universais, Shaders CRT 4K, PCSX2 PS2 Pro, Dolphin GameCube/Wii e RetroArch completo.
                            </p>

                            <div class="flex items-center justify-between pt-4 border-t border-cyber-border">
                                <div>
                                    <span class="text-gray-400 text-xs line-through block font-orbitron">R$ 199,90</span>
                                    <span class="font-orbitron text-3xl font-black text-xbox">R$ 49,90</span>
                                </div>
                                <button type="button" onclick="addToCart(1)" class="px-6 py-3 bg-xbox text-black hover:bg-xbox-glow font-orbitron font-bold text-xs uppercase rounded transition-all shadow-neon-xbox clip-btn cursor-pointer">
                                    <i class="fa-solid fa-cart-plus mr-1"></i> Comprar
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- PACKAGES / PRODUCTS CATALOG SECTION -->
        <section id="packages" class="py-16 relative bg-black/60 border-b border-cyber-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <span class="bg-xbox/20 text-xbox border border-xbox/50 font-orbitron text-xs px-3 py-1 rounded uppercase tracking-widest font-bold">
                        CATÁLOGO DE PACOTES NEBULOSO
                    </span>
                    <h2 class="font-orbitron text-3xl sm:text-4xl font-black text-white uppercase tracking-wider mt-3 mb-2">
                        ESCOLHA O SEU <span class="text-xbox">PACOTE DEV MODE</span>
                    </h2>
                    <div class="w-28 h-1 bg-xbox mx-auto mb-4 shadow-neon-xbox"></div>
                    <p class="font-rajdhani text-gray-300 text-lg">
                        Selecione a opção perfeita para a sua necessidade de emulação no Xbox.
                    </p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    
                    <!-- DEV MODE BÁSICO CARD -->
                    <div class="bg-cyber-card border-2 border-cyber-cyan/70 hover:border-cyber-cyan rounded-2xl p-6 sm:p-8 shadow-xl backdrop-blur-lg clip-corner flex flex-col justify-between transition-all hover:shadow-neon-cyan">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="bg-cyber-cyan/20 text-cyber-cyan border border-cyber-cyan/50 font-orbitron text-xs font-bold px-3 py-1 rounded uppercase">
                                    INICIAL / ESSENCIAL
                                </span>
                                <span class="font-orbitron text-xs text-gray-400">R$ 99,90</span>
                            </div>

                            <div class="relative h-48 rounded-xl overflow-hidden mb-5 border border-cyber-border">
                                <img src="https://i.postimg.cc/h47j60wZ/NEBULOSO.png" alt="Dev Mode Básico" class="w-full h-full object-cover">
                                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                                <div class="absolute bottom-3 left-3 bg-black/90 px-3 py-1 rounded border border-cyber-cyan text-cyber-cyan font-orbitron text-xs font-bold">
                                    <i class="fa-solid fa-cube mr-1"></i> DEV MODE BÁSICO
                                </div>
                            </div>

                            <div class="flex items-baseline justify-between mb-4">
                                <h3 class="font-orbitron text-2xl font-black text-white">DEV MODE BÁSICO</h3>
                                <div class="text-right">
                                    <span class="font-orbitron text-3xl font-black text-cyber-cyan">R$ 30,00</span>
                                </div>
                            </div>

                            <p class="font-sans text-xs text-gray-300 mb-6 leading-relaxed">
                                Pacote essencial para quem busca atração e configuração rápida no seu console Xbox.
                            </p>

                            <ul class="space-y-2.5 font-rajdhani text-sm text-gray-200 mb-8">
                                <li class="flex items-center">
                                    <i class="fa-solid fa-check text-cyber-cyan mr-3"></i>
                                    <span><strong>Ativação Dev Mode:</strong> Auxílio para ativação e pareamento da licença.</span>
                                </li>
                                <li class="flex items-center">
                                    <i class="fa-solid fa-check text-cyber-cyan mr-3"></i>
                                    <span><strong>Sumário da Comunidade:</strong> Acesso às compilações e links da comunidade.</span>
                                </li>
                                <li class="flex items-center">
                                    <i class="fa-solid fa-check text-cyber-cyan mr-3"></i>
                                    <span><strong>Arquivos BIOS:</strong> Pacote base de BIOS essenciais do sistema.</span>
                                </li>
                                <li class="flex items-center">
                                    <i class="fa-solid fa-check text-cyber-cyan mr-3"></i>
                                    <span><strong>Guia de Instalação:</strong> Tutorial simplificado passo a passo incluso.</span>
                                </li>
                            </ul>
                        </div>

                        <div class="pt-4 border-t border-cyber-border flex gap-3">
                            <button type="button" onclick="addToCart(2)" class="flex-1 py-3.5 bg-cyber-cyan text-black hover:bg-white font-orbitron font-bold text-xs uppercase rounded transition-all shadow-neon-cyan clip-btn cursor-pointer">
                                <i class="fa-solid fa-cart-plus mr-1"></i> Comprar - R$ 30,00
                            </button>
                            <button type="button" onclick="openProductModal(2)" class="py-3.5 px-4 bg-black/80 border border-cyber-border text-gray-300 hover:text-white font-orbitron font-bold text-xs uppercase rounded transition-all clip-btn cursor-pointer">
                                <i class="fa-solid fa-info-circle"></i>
                            </button>
                        </div>
                    </div>

                    <!-- DEV MODE CRISTALINO CARD -->
                    <div class="bg-cyber-card border-2 border-xbox hover:border-xbox rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-lg clip-corner flex flex-col justify-between transition-all hover:shadow-neon-xbox relative">
                        <div class="absolute -top-3.5 right-6 bg-cyber-pink text-white font-orbitron text-[10px] font-bold px-3 py-1 rounded shadow-lg uppercase tracking-wider">
                            🔥 MÁXIMA RECOMENDAÇÃO
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="bg-xbox/20 text-xbox border border-xbox/50 font-orbitron text-xs font-bold px-3 py-1 rounded uppercase">
                                    COMPLETO 4K 60FPS
                                </span>
                                <span class="font-orbitron text-xs text-gray-400 line-through">R$ 199,90</span>
                            </div>

                            <div class="relative h-48 rounded-xl overflow-hidden mb-5 border border-cyber-border">
                                <img src="https://i.postimg.cc/h47j60wZ/NEBULOSO.png" alt="Dev Mode Cristalino" class="w-full h-full object-cover">
                                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                                <div class="absolute bottom-3 left-3 bg-black/90 px-3 py-1 rounded border border-xbox text-xbox font-orbitron text-xs font-bold">
                                    <i class="fa-solid fa-gem mr-1"></i> DEV MODE CRISTALINO
                                </div>
                            </div>

                            <div class="flex items-baseline justify-between mb-4">
                                <h3 class="font-orbitron text-2xl font-black text-white">DEV MODE CRISTALINO</h3>
                                <div class="text-right">
                                    <span class="font-orbitron text-3xl font-black text-xbox">R$ 49,90</span>
                                </div>
                            </div>

                            <p class="font-sans text-xs text-gray-300 mb-6 leading-relaxed">
                                Pacote supremo definitivo. Suporte total a PS2 em 4K, GameCube/Wii, Shaders CRT Neon, BIOS universais e atendimento de suporte prioritário.
                            </p>

                            <ul class="space-y-2.5 font-rajdhani text-sm text-gray-200 mb-8">
                                <li class="flex items-center">
                                    <i class="fa-solid fa-check text-xbox mr-3"></i>
                                    <span><strong>PCSX2 PS2 Pro 4K:</strong> Renderização HD Upscaled 60FPS.</span>
                                </li>
                                <li class="flex items-center">
                                    <i class="fa-solid fa-check text-xbox mr-3"></i>
                                    <span><strong>Dolphin GameCube & Wii:</strong> Mapeamento perfeito de controles Xbox.</span>
                                </li>
                                <li class="flex items-center">
                                    <i class="fa-solid fa-check text-xbox mr-3"></i>
                                    <span><strong>Shaders & Filtros CRT Neon:</strong> Visual retro cristalino otimizado.</span>
                                </li>
                                <li class="flex items-center">
                                    <i class="fa-solid fa-check text-xbox mr-3"></i>
                                    <span><strong>Suporte Prioritário VIP:</strong> Atendimento direto via WhatsApp.</span>
                                </li>
                            </ul>
                        </div>

                        <div class="pt-4 border-t border-cyber-border flex gap-3">
                            <button type="button" onclick="addToCart(1)" class="flex-1 py-3.5 bg-xbox text-black hover:bg-xbox-glow font-orbitron font-bold text-xs uppercase rounded transition-all shadow-neon-xbox clip-btn cursor-pointer">
                                <i class="fa-solid fa-cart-plus mr-1"></i> Comprar - R$ 49,90
                            </button>
                            <button type="button" onclick="openProductModal(1)" class="py-3.5 px-4 bg-black/80 border border-cyber-border text-gray-300 hover:text-white font-orbitron font-bold text-xs uppercase rounded transition-all clip-btn cursor-pointer">
                                <i class="fa-solid fa-info-circle"></i>
                            </button>
                        </div>
                    </div>

                </div>

            </div>
        </section>

        <!-- EMULATORS SHOWCASE SECTION -->
