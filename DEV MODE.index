    <!-- JAVASCRIPT LOGIC -->
    <script>
        const canvas = document.getElementById('snow-canvas');
        const ctx = canvas ? canvas.getContext('2d') : null;

        let particles = [];
        const particleCount = 75;

        function resizeCanvas() {
            if (!canvas) return;
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.reset();
            }

            reset() {
                if (!canvas) return;
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height - canvas.height;
                this.size = Math.random() * 3 + 1;
                this.speedY = Math.random() * 1.5 + 0.6;
                this.speedX = Math.random() * 0.8 - 0.4;
                this.opacity = Math.random() * 0.7 + 0.3;
                const colors = ['#00FC60', '#107C41', '#00F0FF', '#00FF99'];
                this.color = colors[Math.floor(Math.random() * colors.length)];
            }

            update() {
                if (!canvas) return;
                this.y += this.speedY;
                this.x += this.speedX;

                if (this.y > canvas.height) {
                    this.reset();
                }
            }

            draw() {
                if (!ctx) return;
                ctx.save();
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.globalAlpha = this.opacity;
                ctx.shadowBlur = 12;
                ctx.shadowColor = this.color;
                ctx.fill();
                ctx.restore();
            }
        }

        function initParticles() {
            particles = [];
            for (let i = 0; i < particleCount; i++) {
                particles.push(new Particle());
            }
        }

        function animateParticles() {
            if (ctx && canvas) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                particles.forEach(p => {
                    p.update();
                    p.draw();
                });
            }
            requestAnimationFrame(animateParticles);
        }

        initParticles();
        animateParticles();

        // Product Catalog Database
        const products = [
            {
                id: 1,
                name: "DEV MODE CRISTALINO - PACOTE SUPREMO",
                category: "devmode",
                price: 49.90,
                oldPrice: 199.90,
                rating: 5.0,
                badge: "RECOMENDADO 4K",
                image: "https://i.postimg.cc/h47j60wZ/NEBULOSO.png",
                description: "O mais completo pacote para Xbox Dev Mode. Acompanha BIOS universais atualizadas, PCSX2 PS2 4K, Dolphin GameCube/Wii, RetroArch e MAME com shaders CRT e filtros Cristalino.",
                romCount: "+50.000 Jogos Suportados",
                systems: "PS2, PS1, GameCube, Wii, SNES, Mega Drive, Arcade, N64",
                cardLink: "https://link.infinitepay.io/nolaggameplay/VC1D-EmQkdM3qaI-49,90",
                pixCode: "00020101021226710014BR.GOV.BCB.PIX0123nolaggameplay@gmail.com0222Pagamento nolaggamepla520400005303986540549.905802BR5925ADRIAN CRIS DE SOUSA MARI6008PACATUBA62290525QRCCGcKynOSkH8fkqMxwaUHwL63042C1C"
            },
            {
                id: 2,
                name: "DEV MODE BÁSICO - PACOTE ESSENCIAL",
                category: "devmode",
                price: 30.00,
                oldPrice: 99.90,
                rating: 4.8,
                badge: "INICIAL / BÁSICO",
                image: "https://i.postimg.cc/h47j60wZ/NEBULOSO.png",
                description: "Pacote essencial para quem busca iniciar no Xbox Dev Mode. Inclui auxílio na Ativação Dev Mode, Sumário da Comunidade, Arquivos BIOS e Guia de Instalação.",
                romCount: "Ativação + BIOS",
                systems: "Ativação Dev Mode, Sumário da Comunidade, BIOS, Guia de Instalação",
                cardLink: "https://link.infinitepay.io/nolaggameplay/VC1D-BH2estUjaR-30,00",
                pixCode: "00020101021226710014BR.GOV.BCB.PIX0123nolaggameplay@gmail.com0222Pagamento nolaggamepla520400005303986540530.005802BR5925ADRIAN CRIS DE SOUSA MARI6008PACATUBA62290525QRCCn5uITtVY1LzDHMqnglcU363042304"
            }
        ];

        // Shopping Cart State
        let cart = [{ ...products[0], quantity: 1 }];

        let currentCardPayUrl = "https://link.infinitepay.io/nolaggameplay/VC1D-EmQkdM3qaI-49,90";

        function openCardPayment() {
            if (currentCardPayUrl) {
                window.open(currentCardPayUrl, '_blank');
            }
        }

        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existing = cart.find(item => item.id === productId);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            updateCartUI();
            openCartDrawer();
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item.id !== productId);
            updateCartUI();
        }

        function updateCartUI() {
            const cartCountEl = document.getElementById('cartCount');
            const cartListEl = document.getElementById('cartItemsList');
            const subtotalEl = document.getElementById('cartSubtotal');
            const totalEl = document.getElementById('cartTotal');

            if (!cartCountEl || !cartListEl) return;

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartCountEl.textContent = totalItems;

            if (cart.length === 0) {
                cartListEl.innerHTML = `
                    <div class="text-center py-12 text-gray-500 font-orbitron">
                        <i class="fa-solid fa-cart-arrow-down text-4xl mb-3 text-gray-600"></i>
                        <p>Seu carrinho está vazio.</p>
                    </div>
                `;
                if (subtotalEl) subtotalEl.textContent = 'R$ 0,00';
                if (totalEl) totalEl.textContent = 'R$ 0,00';
                return;
            }

            cartListEl.innerHTML = '';
            let subtotal = 0;

            cart.forEach(item => {
                subtotal += item.price * item.quantity;
                const itemEl = document.createElement('div');
                itemEl.className = "flex items-center justify-between bg-black/70 p-3.5 rounded border border-cyber-border";
                itemEl.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <img src="${item.image}" alt="${item.name}" class="w-12 h-12 object-cover rounded border border-cyber-border">
                        <div>
                            <h4 class="font-orbitron text-xs font-bold text-white line-clamp-1">${item.name}</h4>
                            <span class="font-orbitron text-xs text-xbox font-semibold">R$ ${item.price.toFixed(2)} (x${item.quantity})</span>
                        </div>
                    </div>
                    <button type="button" onclick="removeFromCart(${item.id})" class="text-gray-500 hover:text-cyber-pink p-1 cursor-pointer">
                        <i class="fa-solid fa-trash-can text-sm pointer-events-none"></i>
                    </button>
                `;
                cartListEl.appendChild(itemEl);
            });

            if (subtotalEl) subtotalEl.textContent = `R$ ${subtotal.toFixed(2)}`;
            if (totalEl) totalEl.textContent = `R$ ${subtotal.toFixed(2)}`;
        }

        const cartDrawer = document.getElementById('cartDrawer');
        const cartBtn = document.getElementById('cartBtn');
        const closeCartBtn = document.getElementById('closeCartBtn');
        const cartBackdrop = document.getElementById('cartBackdrop');

        function openCartDrawer() {
            cartDrawer?.classList.remove('hidden');
        }
        function closeCartDrawer() {
            cartDrawer?.classList.add('hidden');
        }

        cartBtn?.addEventListener('click', openCartDrawer);
        closeCartBtn?.addEventListener('click', closeCartDrawer);
        cartBackdrop?.addEventListener('click', closeCartDrawer);

        function processCheckout() {
            if (cart.length === 0) return;
            closeCartDrawer();

            const primaryItem = cart[0];
            const totalPrice = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

            // Update modal text elements
            const productNameEl = document.getElementById('checkoutProductName');
            const productPriceEl = document.getElementById('checkoutProductPrice');
            const pixInputEl = document.getElementById('pixCodeInput');
            const pixQrImgEl = document.getElementById('pixQrImg');
            const cardPayBtnText = document.getElementById('cardPayBtnText');

            if (productNameEl) productNameEl.textContent = primaryItem ? primaryItem.name : "PACOTE DEV MODE";
            if (productPriceEl) productPriceEl.textContent = `R$ ${totalPrice.toFixed(2)}`;

            // Selected link and pix payload setup
            let activePixCode = primaryItem?.pixCode || "00020101021226710014BR.GOV.BCB.PIX0123nolaggameplay@gmail.com0222Pagamento nolaggamepla520400005303986540549.905802BR5925ADRIAN CRIS DE SOUSA MARI6008PACATUBA62290525QRCCGcKynOSkH8fkqMxwaUHwL63042C1C";
            currentCardPayUrl = primaryItem?.cardLink || "https://link.infinitepay.io/nolaggameplay/VC1D-EmQkdM3qaI-49,90";

            if (pixInputEl) pixInputEl.value = activePixCode;
            if (pixQrImgEl) pixQrImgEl.src = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(activePixCode)}`;
            if (cardPayBtnText) cardPayBtnText.textContent = `PAGAR R$ ${totalPrice.toFixed(2)} NO CARTÃO DE CRÉDITO`;

            document.getElementById('checkoutModal')?.classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkoutModal')?.classList.add('hidden');
        }

        function switchPayMethod(method) {
            const tabPix = document.getElementById('payTabPix');
            const tabCard = document.getElementById('payTabCard');
            const contentPix = document.getElementById('payContentPix');
            const contentCard = document.getElementById('payContentCard');

            if (!tabPix || !tabCard || !contentPix || !contentCard) return;

            if (method === 'pix') {
                tabPix.className = "font-orbitron text-xs font-bold py-2.5 px-3 rounded-lg border border-xbox text-xbox bg-xbox/10 flex items-center justify-center space-x-2 transition-all shadow-neon-xbox cursor-pointer";
                tabCard.className = "font-orbitron text-xs font-bold py-2.5 px-3 rounded-lg border border-cyber-border text-gray-400 hover:text-white flex items-center justify-center space-x-2 transition-all cursor-pointer";
                contentPix.classList.remove('hidden');
                contentCard.classList.add('hidden');
            } else {
                tabCard.className = "font-orbitron text-xs font-bold py-2.5 px-3 rounded-lg border border-cyber-cyan text-cyber-cyan bg-cyber-cyan/10 flex items-center justify-center space-x-2 transition-all shadow-neon-cyan cursor-pointer";
                tabPix.className = "font-orbitron text-xs font-bold py-2.5 px-3 rounded-lg border border-cyber-border text-gray-400 hover:text-white flex items-center justify-center space-x-2 transition-all cursor-pointer";
                contentCard.classList.remove('hidden');
                contentPix.classList.add('hidden');
            }
        }

        function copyPixCode() {
            const pixInput = document.getElementById('pixCodeInput');
            if (!pixInput) return;

            pixInput.select();
            pixInput.setSelectionRange(0, 99999);
            
            try {
                document.execCommand('copy');
            } catch (err) {
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(pixInput.value);
                }
            }

            const copyBtnText = document.getElementById('copyPixText');
            const copyPixBtn = document.getElementById('copyPixBtn');

            if (copyBtnText) copyBtnText.textContent = 'COPIADO!';
            if (copyPixBtn) copyPixBtn.classList.replace('bg-xbox', 'bg-cyber-cyan');

            setTimeout(() => {
                if (copyBtnText) copyBtnText.textContent = 'COPIAR';
                if (copyPixBtn) copyPixBtn.classList.replace('bg-cyber-cyan', 'bg-xbox');
            }, 2500);
        }

        const productModal = document.getElementById('productModal');
        const modalContent = document.getElementById('modalContent');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const modalOverlay = document.getElementById('modalOverlay');

        function openProductModal(productId) {
            const p = products.find(item => item.id === productId);
            if (!p || !modalContent) return;

            modalContent.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="rounded-lg overflow-hidden border border-cyber-border">
                        <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover">
                    </div>
                    <div class="space-y-4">
                        <span class="bg-xbox/20 text-xbox border border-xbox/40 font-orbitron text-[10px] font-bold px-2.5 py-1 rounded">
                            ${p.badge}
                        </span>
                        <h2 class="font-orbitron font-bold text-xl text-white">${p.name}</h2>
                        <p class="font-sans text-xs text-gray-300 leading-relaxed">${p.description}</p>
                        
                        <div class="bg-black/60 p-3 rounded border border-cyber-border space-y-1 font-rajdhani text-xs">
                            <p class="text-gray-300"><strong class="text-white">Capacidade:</strong> ${p.romCount}</p>
                            <p class="text-gray-300"><strong class="text-white">Consoles emulados:</strong> ${p.systems}</p>
                            <p class="text-gray-300"><strong class="text-white">Compatibilidade:</strong> Xbox Series X|S & Xbox One</p>
                        </div>

                        <div class="flex items-center justify-between pt-2">
                            <div>
                                <span class="text-gray-500 text-xs line-through block font-orbitron">R$ ${p.oldPrice.toFixed(2)}</span>
                                <span class="font-orbitron font-extrabold text-2xl text-xbox">R$ ${p.price.toFixed(2)}</span>
                            </div>
                            <button type="button" onclick="addToCart(${p.id}); closeModal();" class="px-6 py-3 bg-xbox text-black font-orbitron font-bold text-xs uppercase rounded hover:bg-xbox-glow transition-all shadow-neon-xbox cursor-pointer">
                                <i class="fa-solid fa-cart-plus mr-1"></i> Comprar Agora
                            </button>
                        </div>
                    </div>
                </div>
            `;

            productModal?.classList.remove('hidden');
        }

        function closeModal() {
            productModal?.classList.add('hidden');
        }

        closeModalBtn?.addEventListener('click', closeModal);
        modalOverlay?.addEventListener('click', closeModal);

        const tutorialSteps = [
            {
                step: 1,
                title: "1. CONTA MICROSOFT PARTNER CENTER",
                description: "Registre seu perfil na conta de desenvolvedor da Microsoft para liberar a licença do Dev Mode de maneira 100% legal e segura.",
                icon: "fa-user-shield",
                highlights: ["Garantia do console mantida", "Sem risco de banimento na Live", "Licença vitalícia"]
            },
            {
                step: 2,
                title: "2. ATIVAÇÃO NO CONSOLE XBOX",
                description: "Baixe o aplicativo 'Xbox Dev Mode' na Microsoft Store do seu Xbox Series X|S ou One. Insira o código no painel para parear.",
                icon: "fa-tv",
                highlights: ["Troca fácil entre Dev e Varejo", "Acesso total a GPU e DirectX 12", "Ativação em minutos"]
            },
            {
                step: 3,
                title: "3. INSTALAÇÃO DO DEV MODE",
                description: "Acesse o painel web do seu Xbox via navegador do computador. Envie o pacote DEV MODE diretamente pelo IP do console.",
                icon: "fa-download",
                highlights: ["Instalação limpa via rede local", "BIOS e Shaders já integrados", "Sem modificações físicas"]
            },
            {
                step: 4,
                title: "4. CARREGUE SUAS ROMS E JOGUE EM 4K",
                description: "Conecte seu pendrive ou HD em formato NTFS no Xbox ou envie via FTP. Execute seus jogos favoritos com máxima performance!",
                icon: "fa-gamepad",
                highlights: ["Visual cristalino com filtros CRT", "Suporte a múltiplos controles", "Save states na nuvem"]
            }
        ];

        function setTutorialStep(stepNumber) {
            document.querySelectorAll('.tut-tab').forEach((tab, index) => {
                if (index + 1 === stepNumber) {
                    tab.className = "tut-tab active font-orbitron text-xs md:text-sm font-bold p-3 rounded border border-xbox text-xbox bg-xbox/10 flex items-center justify-center space-x-2 transition-all shadow-neon-xbox cursor-pointer";
                    const numSpan = tab.querySelector('span:first-child');
                    if (numSpan) numSpan.className = "w-6 h-6 rounded-full bg-xbox text-black flex items-center justify-center font-bold text-xs pointer-events-none";
                } else {
                    tab.className = "tut-tab font-orbitron text-xs md:text-sm font-bold p-3 rounded border border-cyber-border text-gray-400 hover:text-white flex items-center justify-center space-x-2 transition-all cursor-pointer";
                    const numSpan = tab.querySelector('span:first-child');
                    if (numSpan) numSpan.className = "w-6 h-6 rounded-full bg-gray-800 text-gray-300 flex items-center justify-center font-bold text-xs pointer-events-none";
                }
            });

            const data = tutorialSteps.find(s => s.step === stepNumber);
            const container = document.getElementById('tutorialContent');

            if (data && container) {
                container.innerHTML = `
                    <div class="md:col-span-8 space-y-4">
                        <h3 class="font-orbitron text-xl font-bold text-white flex items-center">
                            <i class="fa-solid ${data.icon} text-xbox mr-3 text-2xl"></i> ${data.title}
                        </h3>
                        <p class="font-sans text-sm text-gray-300 leading-relaxed">${data.description}</p>
                        <ul class="space-y-2 pt-2">
                            ${data.highlights.map(h => `
                                <li class="flex items-center text-xs font-rajdhani text-gray-300">
                                    <i class="fa-solid fa-check text-xbox mr-2"></i> ${h}
                                </li>
                            `).join('')}
                        </ul>
                    </div>
                    <div class="md:col-span-4 bg-black/70 border border-xbox/40 p-6 rounded-xl text-center flex flex-col items-center justify-center space-y-3">
                        <i class="fa-solid ${data.icon} text-5xl text-xbox animate-pulse"></i>
                        <span class="font-orbitron text-xs font-bold text-gray-300 uppercase">Passo ${data.step} de 4</span>
                        <span class="font-rajdhani text-xs text-cyber-cyan">Suporte Especializado NEBULOSO</span>
                    </div>
                `;
            }
        }

        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');

        mobileMenuBtn?.addEventListener('click', () => {
            mobileMenu?.classList.toggle('hidden');
        });

        window.onload = function() {
            setTutorialStep(1);
            updateCartUI();
        };
    </script>
</body>
</html>
